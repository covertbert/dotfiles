[include]
path = user.gitconfig
path = themes.gitconfig

# Repositories on github.com sign with the GitHub key; everything else falls
# back to the GitLab key set in user.gitconfig.
[includeIf "hasconfig:remote.*.url:git@github.com:**/**"]
path = signing-github.gitconfig
[includeIf "hasconfig:remote.*.url:https://github.com/**"]
path = signing-github.gitconfig

[init]
defaultBranch = main

[core]
pager = delta
excludesfile = /Users/bertieblackman/.config/git/ignore

[interactive]
diffFilter = delta --color-only

[delta]
navigate = true # use n and N to move between diff sections
features = calochortus-lyallii

[merge]
conflictstyle = diff3

[diff]
colorMoved = default

[gpg]
format = ssh

[commit]
gpgSign = true

[tag]
forceSignAnnotated = true

[push]
autoSetupRemote = true
default = current
[checkout]
defaultRemote = origin
