{
  "shellPath": "/bin/bash",
  "npmCommand": ["npx", "--yes", "pnpm@10.29.2"],
  "enabledModels": [
    "anthropic/claude-sonnet-4-6",
    "anthropic/claude-opus-4-8",
    "google/gemini-flash-lite-latest",
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-5.6-terra",
    "openai-codex/gpt-5.6-luna",
    "runai/qwen3-8-27b",
    "runai/qwen3-8-flash-next",
    "opencode/muse-spark-1.3-contributor-free"
  ],
  "packages": [
    "npm:pi-caveman",
    "npm:pi-mcp-adapter",
    "npm:pi-powerline-footer",
    "npm:pi-frontend-create",
    "npm:pi-web-access",
    "npm:@plannotator/pi-extension@0.27.7",
    "npm:@dietrichgebert/ponytail@4.8.4",
    "git:github.com/be-ayush/pi-diagram@ad5f7838bd6888d04f72b1a89829994fc055a2ea"
  ],
  "hideThinkingBlock": false,
  "powerline": {
    "preset": "default",
    "fixedEditor": true,
    "mouseScroll": true
  },
  "bashMode": {
    "toggleShortcut": "ctrl+shift+b",
    "transcriptMaxLines": 2000,
    "transcriptMaxBytes": 524288
  },
  "workingVibe": "caveman",
  "workingVibeMode": "file",
  "workingVibeFallback": "Working",
  "workingVibeMaxLength": 65,
  "theme": "dark",
  "steeringMode": "all"
}
