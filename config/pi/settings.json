{
  "shellPath": "/bin/bash",
  "enabledModels": [
    "anthropic/claude-fable-5-1",
    "anthropic/claude-opus-5-5",
    "openai-codex/gpt-6.1-sol",
    "runai/qwen3-8-27b",
    "runai/deepseek-v4-1-flash",
    "opencode/muse-spark-1.3-contributor-free"
  ],
  "extensions": ["-builtin:mcp"],
  "packages": [
    "npm:pi-caveman",
    "npm:pi-mcp-adapter",
    "npm:pi-powerline-footer",
    "npm:pi-frontend-create",
    "npm:pi-web-access",
    "npm:@plannotator/pi-extension@0.27.7",
    "npm:@dietrichgebert/ponytail@4.8.4",
    "npm:@mcuste/pi-diagram@0.6.2"
  ],
  "hideThinkingBlock": false,
  "powerline": {
    "preset": "default",
    "fixedEditor": true,
    "mouseScroll": true
  },
  "bashMode": {
    "toggleShortcut": "ctrl+shift+b",
    "transcriptMaxLines": 2000,
    "transcriptMaxBytes": 524288
  },
  "workingVibe": "caveman",
  "workingVibeMode": "file",
  "workingVibeFallback": "Working",
  "workingVibeMaxLength": 65,
  "theme": "dark",
  "steeringMode": "all"
}
