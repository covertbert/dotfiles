{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"]
    },
    "gitlab": {
      "command": "npx",
      "args": ["-y", "@zereight/mcp-gitlab"],
      "env": {
        "GITLAB_PERSONAL_ACCESS_TOKEN": "${GITLAB_PERSONAL_ACCESS_TOKEN}",
        "GITLAB_API_URL": "https://gitlab.com/api/v4"
      },
      "lifecycle": "lazy"
    },
    "notion": {
      "url": "https://mcp.notion.com/mcp",
      "auth": "oauth",
      "lifecycle": "lazy"
    },
    "linearb": {
      "url": "https://mcp.linearb.io/mcp",
      "headers": {
        "x-api-key": "${LINEARB_API_KEY}"
      },
      "lifecycle": "lazy"
    },
    "cloudflare": {
      "url": "https://mcp.cloudflare.com/mcp",
      "auth": "oauth",
      "lifecycle": "lazy",
      "approveTools": [
        "create_*",
        "edit_*",
        "update_*",
        "delete_*",
        "trigger_*",
        "run_*",
        "execute_*"
      ]
    },
    "datadog": {
      "url": "https://mcp.datadoghq.eu/v1/mcp",
      "headers": {
        "DD_API_KEY": "${DD_API_KEY}",
        "DD_APPLICATION_KEY": "${DD_APP_KEY}"
      },
      "auth": false,
      "lifecycle": "lazy",
      "approveTools": [
        "create_*",
        "edit_*",
        "update_*",
        "delete_*",
        "trigger_*",
        "run_*",
        "execute_*"
      ]
    }
  }
}
