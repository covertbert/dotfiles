<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: `dotfiles web start` substitutes __PI_WEB_BIN__ with the resolved
     pi-web path and installs the result to ~/Library/LaunchAgents/.
     pi-web stays bound to loopback; remote access is `tailscale serve`. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.blackmanrgh.pi-web</string>
	<key>ProgramArguments</key>
	<array>
		<string>__PI_WEB_BIN__</string>
		<string>--host</string>
		<string>127.0.0.1</string>
		<string>--port</string>
		<string>8192</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>__NODE_BIN_DIR__:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>WorkingDirectory</key>
	<string>/Users/bertieblackman</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/Users/bertieblackman/Library/Logs/pi-web.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/bertieblackman/Library/Logs/pi-web.log</string>
</dict>
</plist>
